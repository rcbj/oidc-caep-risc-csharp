<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>IyaSec.Oidc</RootNamespace>
    <AssemblyName>IyaSec.OidcCaepRisc</AssemblyName>
    <Version>0.2.0</Version>
    <Description>Confidential OpenID Connect relying party and one CAEP/RISC poll stream</Description>
    <Authors>Iya CyberSecurity Solutions, LLC</Authors>
    <Copyright>2026 Iya CyberSecurity Solutions, LLC</Copyright>
    <PackageId>IyaSec.OidcCaepRisc</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
    <PackageProjectUrl>https://github.com/rcbj/oidc-caep-risc-csharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rcbj/oidc-caep-risc-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>openid-connect;oidc;caep;risc;ssf</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
